# Copie para .env e preencha. O .env nunca entra no git nem é lido por agentes.
# `bun run dev` carrega este .env da raiz em cada app (bun --env-file=../../.env).
# Cada app valida as suas variáveis com Zod no boot (config.ts) e derruba o processo
# se uma obrigatória faltar. Valores abaixo são exemplos, não credenciais.

# --- Geral ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent; debug e trace são recusados com NODE_ENV=production
LOG_LEVEL=info
# Interface em que api e health do worker escutam; em container, 0.0.0.0
HOST=127.0.0.1

# --- Banco (Postgres 16 do docker-compose, porta 5433 no host) ---
DATABASE_URL=postgres://gizito:gizito@127.0.0.1:5433/gizito
# Os test-helpers de @gizito/db criam e dropam bancos gizito_test_* no servidor desta URL
# (default: o Postgres do compose). Nunca aponte para o servidor da aplicação em produção.
# TEST_DATABASE_URL=postgres://gizito:gizito@127.0.0.1:5433/gizito

# --- API (apps/api) ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Obrigatória; o CORS da api libera só a origem desta URL
WEB_PUBLIC_URL=http://localhost:3000
PREVIEW_RATE_LIMIT_PER_HOUR=3
PREVIEW_RATE_LIMIT_PER_DAY=6

# --- Worker (apps/worker) ---
WORKER_HEALTH_PORT=3002
# Vagas da raia de order.generate; inteiro >= 1
GENERATE_CONCURRENCY=2
RENDER_CONCURRENCY=1
MAX_AI_COST_CENTS_PER_ORDER=300

# --- IA (um provedor atrás de AiProvider; modelo barato na extração, forte na geração) ---
AI_API_KEY=
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_GENERATE=claude-sonnet-5-5

# --- Pagamento (PAYMENT_GATEWAY=mercadopago | fake; obrigatória; fake é recusado com NODE_ENV=production) ---
PAYMENT_GATEWAY=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Storage privado (Cloudflare R2) ---
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=gizito
R2_REGION=auto
R2_ACCESS_KEY_ID=gizito
R2_SECRET_ACCESS_KEY=gizito-local-dev
CLIENT_HASH_SECRET=(32 caracteres ou mais)
TRUSTED_PROXY_HOP_COUNT=0 (em produção, 1)

# --- E-mail (Resend, domínio autenticado) ---
RESEND_API_KEY=
EMAIL_FROM=Gizito <kit@example.com>

# --- WhatsApp (Evolution API; WHATSAPP_ENABLED=false desliga botão, webhook e envios) ---
# O docker-compose.yml lê EVOLUTION_API_KEY deste arquivo (.env) como AUTHENTICATION_API_KEY
# da Evolution; sem .env ele usa o default só-local "gizito-local-dev-key". Em produção é obrigatória.
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=gizito-local-dev-key
EVOLUTION_INSTANCE_NAME=gizito
WHATSAPP_MAX_SENDS_PER_MINUTE=10

# Redis (docker-compose, 127.0.0.1:6379) é usado só pela Evolution API, com URL fixa no
# docker-compose.yml. Nenhuma app lê variável de Redis.
