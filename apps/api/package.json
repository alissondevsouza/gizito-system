{
  "name": "@gizito/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@gizito/core": "workspace:*",
    "@gizito/db": "workspace:*",
    "@gizito/integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "~1.3.11"
  }
}
