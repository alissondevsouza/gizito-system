{
  "name": "@gizito/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns '**/integration/**'",
    "test:integration": "bun test src/__tests__/integration"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@gizito/core": "workspace:*",
    "@gizito/db": "workspace:*",
    "@gizito/integrations": "workspace:*",
    "elysia": "^1.4.30",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "~1.3.11"
  }
}
