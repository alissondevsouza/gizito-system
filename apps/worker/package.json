{
  "name": "@gizito/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist --external playwright",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns '**/integration/**'",
    "test:integration": "bun test src/__tests__/integration",
    "test:extract-live": "EXTRACT_LIVE_TEST=1 bun --env-file=../../.env test src/__tests__/pipeline/extract-live.test.ts",
    "test:generate-live": "GENERATE_LIVE_TEST=1 bun --env-file=../../.env test --max-concurrency=5 src/__tests__/pipeline/generate-live.test.ts",
    "render:kit": "bun scripts/render-kit.ts",
    "browser:install": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "@gizito/core": "workspace:*",
    "@gizito/db": "workspace:*",
    "@gizito/integrations": "workspace:*",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "~1.3.11",
    "drizzle-orm": "^0.45.4",
    "sharp": "^0.35.5"
  }
}
