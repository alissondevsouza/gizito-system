{
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run dev*)",
      "Bash(bun run build*)",
      "Bash(bun run lint*)",
      "Bash(bun run typecheck*)",
      "Bash(bun run test*)",
      "Bash(bun run format*)",
      "Bash(bun run db:*)",
      "Bash(bun test*)",
      "Bash(bunx turbo run *)",
      "Bash(bunx biome*)",
      "Bash(bunx drizzle-kit*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git merge-base *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(**/.env*)",
      "Bash(cat .env*)",
      "Bash(cat *.env*)",
      "Edit(**/.env*)",
      "Read(**/tests/pedagogy/cases/**/photos/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$f\" ] && echo \"$f\" | grep -qE '\\.(ts|tsx|js|jsx|json)$' && [ -f \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/biome.json\" ]; then bunx biome check --write \"$f\" 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  }
}
